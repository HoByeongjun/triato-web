---

import Layout from "../layouts/Layout.astro"

import HeroSection from "../components/HeroSection.astro"
import ServicesSection from "../components/ServicesSection.astro"
import QuoteSection from "../components/QuoteSection.astro"
import ProcessSection from "../components/ProcessSection.astro"
import StrengthsSection from "../components/StrengthsSection.astro"
import FaqSection from "../components/FaqSection.astro"
import ContactSection from "../components/ContactSection.astro"

import services from "../data/services.json"
import process from "../data/process.json"
import strengths from "../data/strengths.json"
import faq from "../data/faq.json"
import home from "../data/home.json"
import global_settings from "../data/global_settings.json"

---

<Layout title={ global_settings.title }>

  <HeroSection
    content={ home.hero_content }
    settings={ global_settings }
    title={ home.hero_title }
  />

  <ServicesSection
    services={ services }
    title={ home.services_title }
  />

  <QuoteSection
    cite={ home.quote_cite }
    content={ home.quote_content }
    role={ home.quote_role }
  />

  <ProcessSection
    process={ process }
    title={ home.process_title }
  />

  <StrengthsSection
    strengths={ strengths }
    title={ home.strengths_title }
  />

  <FaqSection
    faq={ faq }
    title={ home.faq_title }
  />

  <ContactSection
    settings={ global_settings }
  />

</Layout>
