---
const { question, answer } = Astro.props
---

<details name="faq"
class="group border-b border-bs-border transition-colors w-full">

  <!-- Summary -->
  <summary class="flex gap-3 justify-between items-center py-5 cursor-pointer">
    <!-- Title -->
    <span class="text-base font-medium text-bs-text select-none group-hover:text-bs-accent transition-colors duration-200" set:html={ question } />

    <!-- Icon -->
    <span class="text-bs-muted shrink-0">
      <svg class="w-5 h-5 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </span>
  </summary>

  <!-- Content -->
  <div class="anim-wrapper max-w-none">
    <div set:html={ answer } class="pb-5 text-[15px] text-bs-body leading-[1.7]" />
  </div>

</details>

<style>

summary::-webkit-details-marker {
  display: none
}

details {

  @media (prefers-reduced-motion: no-preference) {
    interpolate-size: allow-keywords;
  }

  &::details-content {
    block-size: 0;
    opacity: 0;
    overflow-y: clip;
    transition: content-visibility 300ms allow-discrete, opacity 200ms ease-out, block-size 300ms ease-out;
  }

  &[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
}

</style>
