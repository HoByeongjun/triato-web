---
const { title } = Astro.props
const steps = [
  { num: '1', title: '상담 & 기획', desc: '요구사항을 정확히 이해하고 범위와 일정을 확정합니다.', highlight: false },
  { num: '2', title: '개발 & 검증', desc: 'AI 팀이 비동기로 자율 작업하고, 사람이 핵심 결정을 승인합니다.', highlight: false },
  { num: '3', title: '런칭 & 운영', desc: '배포 후 안정화, 유지보수와 운영을 함께합니다.', highlight: true },
]
---

<section class="max-w-[1440px] mx-auto px-6 md:px-20 py-20 md:py-28" id="process">

  <!-- Header -->
  <header class="motion-trigger text-center mb-14 lg:mb-16">
    <span class="text-[13px] font-semibold text-bs-accent uppercase tracking-[0.08em]">PROCESS</span>
    <h2 class="text-[36px] md:text-[44px] font-bold leading-[1.15] tracking-[-0.025em] text-bs-text mt-3 mb-4">{title ?? '프로젝트 진행 방식'}</h2>
    <p class="text-[17px] lg:text-[18px] leading-[1.6] text-bs-body max-w-2xl mx-auto">
      트리거에서 액션까지, 빠르고 투명하게.
    </p>
  </header>

  <!-- 3 step grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 max-w-[1080px] mx-auto">
    {steps.map((step, idx) => (
      <div class="flex flex-col items-center text-center relative">
        {idx > 0 && (
          <div class="hidden md:block absolute top-10 left-[-50%] w-full h-[1px] bg-bs-border-hover -z-10" aria-hidden="true"></div>
        )}
        <div class={`w-20 h-20 rounded-full flex items-center justify-center mb-6 shadow-card border ${step.highlight ? 'bg-bs-accent-dim border-bs-border-accent text-bs-accent' : 'bg-white border-bs-border-hover text-bs-text'}`}>
          <span class="text-[28px] font-extrabold">{step.num}</span>
        </div>
        <h3 class="text-[20px] md:text-[22px] font-bold text-bs-text leading-[1.3] tracking-[-0.01em] mb-3">{step.title}</h3>
        <p class="text-[15px] text-bs-body leading-[1.65] max-w-[280px]">{step.desc}</p>
      </div>
    ))}
  </div>
</section>
