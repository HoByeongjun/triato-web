---
const steps = [
  { num: '01', title: '상담 & 기획', desc: '요구사항을 정확히 이해하고 범위와 일정을 확정합니다.' },
  { num: '02', title: '개발 & 검증', desc: 'AI + 풀스택 팀이 스프린트 단위로 빠르게 만들어갑니다.' },
  { num: '03', title: '런칭 & 운영', desc: '배포 후 안정화, 유지보수와 운영을 지원합니다.' },
]
---

<section class="bg-white" id="process">
  <div class="bs-container py-24 lg:py-32">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 lg:mb-20">
      <h2 class="bs-h2">프로젝트 진행 방식</h2>
      <p class="text-bs-body mt-5 text-base lg:text-[17px] leading-[1.75]">빠르고 투명하게, 처음부터 끝까지 함께.</p>
    </div>

    <!-- Horizontal 3 steps -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16 relative">
      <!-- Connection line (desktop) -->
      <div class="hidden lg:block absolute top-[28px] left-[calc(16.67%+32px)] right-[calc(16.67%+32px)] h-[1px] bg-gradient-to-r from-bs-accent/20 via-bs-accent/40 to-bs-accent/20"></div>

      {steps.map((step) => (
        <div class="flex flex-col items-center text-center gap-5 relative">
          <!-- Step number + dot -->
          <div class="flex flex-col items-center gap-3">
            <span class="text-xs font-bold text-bs-accent tracking-[0.1em] uppercase">{step.num}</span>
            <div class="w-3 h-3 rounded-full bg-bs-accent ring-4 ring-bs-accent/10 relative z-10"></div>
          </div>

          <!-- Content -->
          <h3 class="text-[19px] font-bold text-bs-text mt-2 tracking-[-0.01em]">{step.title}</h3>
          <p class="text-[15px] text-bs-body leading-[1.75] max-w-[280px]">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
