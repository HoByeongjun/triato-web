---
const { settings } = Astro.props
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-2xl border-b border-transparent transition-all duration-300" id="site-header">
  <div class="bs-container py-4 flex justify-between items-center">
    <!-- Logo -->
    <a class="flex items-center gap-2.5 group" href="/" aria-label="TRIATO - Home">
      <img src="/logo-symbol.png" alt="TRIATO" class="w-8 h-8 object-contain group-hover:scale-95 transition-transform duration-200" />
      <span class="text-[15px] font-bold tracking-[0.02em] text-bs-text hidden sm:block">TRIATO</span>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex mx-auto self-stretch gap-0.5">
      {
        settings.nav.map((item: { link: string; title: string }) => (
          <a class="px-4 py-2 text-sm font-medium text-bs-body hover:text-bs-text transition-colors duration-200 rounded-lg" href={item.link}>
            {item.title}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <button type="button" class="bs-btn text-sm px-5 py-2.5 bg-bs-navy text-white font-semibold hover:bg-bs-navy-hover rounded-xl transition-all duration-200" onclick="demo.showModal()">
      {settings.demo.title}
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('border-black/[0.06]')
      header?.classList.remove('border-transparent')
    } else {
      header?.classList.remove('border-black/[0.06]')
      header?.classList.add('border-transparent')
    }
  }, { passive: true })
</script>
