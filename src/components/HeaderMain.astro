---
const { settings } = Astro.props
---

<header class="fixed top-0 w-full z-50 border-b border-bs-border bg-white/80 backdrop-blur-2xl" id="site-header">
  <nav class="flex justify-between items-center max-w-[1440px] mx-auto px-6 md:px-20 py-5 gap-6">
    <!-- Logo -->
    <a class="inline-flex items-center gap-2.5 group" href="/" aria-label="TRIATO - 홈">
      <img src="/logo-symbol.png" alt="TRIATO" class="w-8 h-8 object-contain group-hover:scale-95 transition-transform duration-200" />
      <span class="text-[20px] font-extrabold tracking-[-0.01em] text-bs-text">TRIATO</span>
    </a>

    <!-- Nav -->
    <div class="hidden md:flex items-center gap-8">
      {settings.nav.map((item: { link: string; title: string }) => (
        <a class="text-[15px] font-medium text-bs-body hover:text-bs-text transition-colors duration-200" href={item.link}>
          {item.title}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <button type="button" class="cta-navy hidden md:inline-flex items-center justify-center px-5 py-2.5 rounded-full text-[13px] font-semibold tracking-[0.02em]" onclick="demo.showModal()">
      {settings.demo.title}
    </button>
  </nav>
</header>
