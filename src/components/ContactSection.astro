---
---

<section class="bg-bs-navy relative overflow-hidden" id="contact">
  <!-- Background accent -->
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-bs-accent/[0.03] blur-3xl"></div>

  <div class="bs-container py-24 lg:py-32 relative">
    <div class="max-w-lg mx-auto text-center flex flex-col items-center gap-5">
      <!-- Title -->
      <h2 class="text-[28px] md:text-[36px] font-extrabold text-white leading-[1.1] tracking-[-0.025em]">프로젝트를 시작할<br />준비가 되셨나요?</h2>

      <!-- Subtitle -->
      <p class="text-white/60 text-base mt-1 leading-[1.7]">지금 바로 무료 상담을 신청하세요.<br />응답까지 평균 24시간 이내.</p>

      <!-- CTA Button -->
      <button
        type="button"
        class="bs-btn mt-6 bg-white text-bs-navy font-bold px-10 py-4 rounded-xl hover:bg-white/95 hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(255,255,255,0.15)] transition-all duration-300"
        onclick="demo.showModal()"
      >
        무료 상담 신청하기
      </button>
    </div>
  </div>
</section>
