<section class="bg-bs-navy" id="contact">
  <div class="bs-container py-20 lg:py-28">
    <div class="max-w-lg mx-auto text-center flex flex-col items-center gap-4">
      <!-- Title -->
      <h2 class="text-2xl md:text-[32px] font-bold text-white leading-[1.2]">프로젝트를 시작할 준비가 되셨나요?</h2>

      <!-- Subtitle -->
      <p class="text-white/70 text-base mt-2">지금 바로 무료 상담을 신청하세요.<br>응답까지 평균 24시간 이내.</p>

      <!-- CTA Button -->
      <button
        type="button"
        class="bs-btn mt-6 bg-white text-bs-navy font-semibold px-8 py-3.5 rounded-lg hover:bg-white/90 hover:-translate-y-px shadow-[0_4px_16px_rgba(0,0,0,0.15)]"
        onclick="demo.showModal()"
      >
        무료 상담 신청하기
      </button>
    </div>
  </div>
</section>
