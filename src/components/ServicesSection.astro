---
type Service = { title: string; content: string; cta: string; tag: string }
const { title, services } = Astro.props as { title: string; services: Service[] }

const featuredTags = new Set(['외부 수주', 'AI'])
---

<section class="max-w-[1440px] mx-auto px-6 md:px-20 py-20 md:py-28" id="services">

  <!-- Header -->
  <header class="motion-trigger mb-12 lg:mb-14">
    <span class="text-[13px] font-semibold text-bs-accent uppercase tracking-[0.08em]">SERVICES</span>
    <h2 class="text-[36px] md:text-[44px] font-bold leading-[1.15] tracking-[-0.025em] text-bs-text mt-3 mb-4" set:html={title} />
    <p class="text-[17px] lg:text-[18px] leading-[1.6] text-bs-body max-w-2xl">
      비즈니스 성장에 필요한 모든 기술적 역량을 한 팀이 제공합니다.
    </p>
  </header>

  <!-- Bento Grid: first card span 2 cols -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {services.map((svc, idx) => {
      const isFirst = idx === 0
      const isFeatured = featuredTags.has(svc.tag)
      return (
        <article class={`glass-panel glass-panel-deep rounded-[24px] p-8 md:p-10 lg:p-12 flex flex-col justify-between min-h-[360px] hover:-translate-y-0.5 transition-all duration-300 ${isFirst ? 'md:col-span-2' : ''}`}>
          <div>
            <span class={`inline-block px-3 py-1 rounded-full text-[11px] font-semibold uppercase tracking-[0.04em] mb-4 ${isFeatured ? 'bg-bs-accent-dim text-bs-accent' : 'bg-bs-bg-alt text-bs-body'}`}>{svc.tag}</span>
            <h3 class={`font-bold text-bs-text leading-[1.3] tracking-[-0.01em] mb-3 ${isFirst ? 'text-[32px] md:text-[36px]' : 'text-[24px] md:text-[26px]'}`}>{svc.title}</h3>
            <div class={`text-[15px] md:text-[16px] text-bs-body leading-[1.65] [&_strong]:text-bs-text [&_strong]:font-semibold ${isFirst ? 'max-w-md' : ''}`} set:html={svc.content} />
          </div>
          <button
            type="button"
            class="self-start mt-6 inline-flex items-center gap-1.5 text-[14px] font-semibold text-bs-accent hover:gap-2.5 transition-all duration-200"
            onclick="demo.showModal()"
          >
            {svc.cta}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </article>
      )
    })}
  </div>
</section>
