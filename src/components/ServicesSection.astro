---
const serviceCards = [
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>`,
    title: '맞춤 소프트웨어 개발',
    description: '웹/앱부터 인프라까지 풀스택 개발. 클라우드 배포까지 원스톱으로 진행합니다.',
    image: '/images/service-dev.jpg',
    imageAlt: '코드 에디터 화면 — 소프트웨어 개발',
    link: '#contact'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>`,
    title: 'AI 솔루션',
    description: 'AI 에이전트, RAG, 챗봇 등 비즈니스에 맞는 AI 솔루션을 맞춤 개발합니다.',
    image: '/images/service-ai.jpg',
    imageAlt: '데이터 분석 대시보드 화면 — AI 솔루션',
    link: '#contact'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182M2.985 19.644l3.181-3.182" /></svg>`,
    title: '업무 자동화',
    description: 'RPA, API 연동으로 반복 업무를 자동화해 팀의 핵심 업무 집중도를 높입니다.',
    image: '/images/service-auto.jpg',
    imageAlt: '개발팀이 협업하는 워크스페이스 — 업무 자동화',
    link: '#contact'
  }
]
---

<section class="bg-bs-bg-alt" id="services">
  <div class="bs-container py-24 lg:py-32">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 lg:mb-20">
      <h2 class="bs-h2">고객의 문제에<br class="sm:hidden" /> 전문가 팀이 직접 붙습니다</h2>
      <p class="text-bs-body mt-5 text-base lg:text-[17px] leading-[1.75]">비즈니스 성장에 필요한 모든 기술적 역량을 제공합니다.</p>
    </div>

    <!-- 3-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
      {serviceCards.map((card) => (
        <article class="bg-white border border-black/[0.06] rounded-2xl overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-hover transition-all duration-300">
          <!-- Card image header -->
          <div class="relative h-48 overflow-hidden">
            <img
              src={card.image}
              alt={card.imageAlt}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              style="filter: brightness(0.92) saturate(0.85);"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-bs-navy/10 to-transparent"></div>
          </div>

          <!-- Content -->
          <div class="p-7 lg:p-8 flex flex-col gap-3 flex-1">
            <!-- Icon -->
            <div class="w-10 h-10 rounded-xl bg-bs-accent-dim flex items-center justify-center text-bs-accent">
              <Fragment set:html={card.icon} />
            </div>

            <!-- Title -->
            <h3 class="text-[19px] font-bold text-bs-text mt-1 tracking-[-0.01em]">{card.title}</h3>

            <!-- Description -->
            <p class="text-[15px] text-bs-body leading-[1.75] flex-1">{card.description}</p>

            <!-- Link -->
            <a href={card.link} class="text-sm font-semibold text-bs-navy mt-4 inline-flex items-center gap-1.5 hover:gap-2.5 transition-all duration-300">
              자세히 알아보기
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
