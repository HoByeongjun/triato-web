---
const { title, strengths } = Astro.props

const icons = {
  bolt: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`,
  layers: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L12 12.75 6.429 9.75m11.142 0l4.179 2.25-9.75 5.25-9.75-5.25 4.179-2.25" /></svg>`,
  sparkles: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>`,
  target: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`,
}

const colors = [
  { bg: 'bg-bs-accent/8', text: 'text-bs-accent', border: 'hover:border-bs-accent/15' },
  { bg: 'bg-bs-green/8', text: 'text-bs-green', border: 'hover:border-bs-green/15' },
  { bg: 'bg-bs-purple/8', text: 'text-bs-purple', border: 'hover:border-bs-purple/15' },
  { bg: 'bg-bs-warm/8', text: 'text-bs-warm', border: 'hover:border-bs-warm/15' },
]
---

<section class="bs-container bs-mt-lg">
  <!-- Title -->
  {title && <h2 class="bs-h2">{title}</h2>}

  <!-- Strengths grid -->
  <div class="bs-mt-md grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {strengths.map((item, i) => (
      <blockquote
        class={`p-6 flex flex-col gap-4 border border-bs-border rounded-xl bg-bs-surface-1/40 transition-all duration-300 ${colors[i].border}`}>

        {/* Icon */}
        <div class={`w-10 h-10 rounded-lg ${colors[i].bg} flex items-center justify-center ${colors[i].text}`}>
          <Fragment set:html={icons[item.icon] || icons.bolt} />
        </div>

        {/* Title */}
        <h3 class="text-lg font-semibold text-bs-foreground-light">{item.title}</h3>

        {/* Quote */}
        <p class="text-sm text-bs-foreground-dark leading-relaxed">{item.quote}</p>
      </blockquote>
    ))}
  </div>
</section>
