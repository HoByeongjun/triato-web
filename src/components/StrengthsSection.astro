---
const { title, strengths } = Astro.props as {
  title: string
  strengths: { icon: string; title: string; quote: string }[]
}

const icons: Record<string, string> = {
  bolt: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
  layers: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L12 12.75 6.429 9.75m11.142 0l4.179 2.25-9.75 5.25-9.75-5.25 4.179-2.25"/></svg>`,
  sparkles: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/></svg>`,
  target: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>`,
}
---

<section class="bg-bs-bg" id="strengths">
  <div class="bs-container py-20 lg:py-28">

    <!-- Section header -->
    <header class="max-w-[720px] mx-auto text-center flex flex-col gap-4 mb-14 lg:mb-16">
      <span class="text-[13px] font-semibold text-bs-accent uppercase tracking-[0.08em]">WHY TRIATO</span>
      {title && <h2 class="bs-h2" set:html={title} />}
      <p class="text-[16px] lg:text-[17px] leading-[1.7] text-bs-body">
        한 팀이 처음부터 끝까지. AI가 일하고, 사람이 결정합니다.
      </p>
    </header>

    <!-- 2x2 cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {strengths.map((item) => (
        <article class="flex flex-col gap-4 p-7 lg:p-8 bg-white border border-bs-border rounded-2xl shadow-card hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-bs-accent-dim flex items-center justify-center text-bs-accent shrink-0">
              <span class="w-5 h-5 inline-block" set:html={icons[item.icon] ?? icons.bolt} />
            </div>
            <div class="flex flex-col gap-2 flex-1">
              <h3 class="text-[18px] lg:text-[19px] font-bold text-bs-text leading-[1.3] tracking-[-0.01em]">{item.title}</h3>
              <p class="text-[14px] lg:text-[15px] leading-[1.7] text-bs-body">{item.quote}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
