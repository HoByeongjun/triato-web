---
import X from '../assets/theme-images/icon-x.svg'

const { content } = Astro.props
---

<dialog id="demo" closedby="any" class="fixed inset-0 bg-bs-surface-0 m-auto z-50 p-6 md:p-12 rounded-xl w-full max-w-[95%] md:max-w-lg">
  <!-- Form -->
  <form method="dialog" class="flex gap-6 flex-col">
    <!-- Header -->
    <h2 class="text-2xl flex justify-between items-center gap-4">
      <span>{content.title}</span>

      <button onclick="this.closest('dialog').close('close')" aria-label="닫기" class="bs-btn rounded-full p-0! flex items-center justify-center h-10 w-10">
        <X class="scale-75 opacity-75" width="32" height="32" />
      </button>
    </h2>

    <!-- Content -->
    <div class="flex flex-col gap-4">
      <div class="bs-body-text mb-3" set:html={content.content} />

      <label class="sr-only" for="name">이름</label>
      <input id="name" type="text" class="border-2 rounded-lg bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors" placeholder="이름" />

      <label class="sr-only" for="company">회사명</label>
      <input id="company" type="text" class="border-2 rounded-lg bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors" placeholder="회사명" />

      <label class="sr-only" for="email">이메일</label>
      <input id="email" type="email" class="border-2 rounded-lg bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors" placeholder="이메일" />

      <label class="sr-only" for="message">프로젝트 설명</label>
      <textarea id="message" rows="3" class="border-2 rounded-lg bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors resize-none" placeholder="어떤 프로젝트를 생각하고 계신가요?"></textarea>

      <a href="mailto:bjho@triato.co.kr" class="bs-btn form-input px-4 py-3 bg-gradient-to-r from-[var(--color-bs-accent)] to-[var(--color-bs-mid)] text-bs-surface-0 font-bold">{content.cta}</a>
    </div>
  </form>
</dialog>

<style>
  html:has(dialog[open]) {
    overflow: hidden;
    backdrop-filter: blur(0);
    scrollbar-gutter: stable;
  }

  dialog[open]::backdrop {
    backdrop-filter: blur(50px);
  }

  @keyframes scale-up {
    to {
      translate: 0 0;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog {
      translate: 0 2rem;
      scale: 0.8;
    }

    dialog[open] {
      animation: scale-up forwards 1s;
      animation-timing-function: var(--ease-bs-spring);
    }
  }
</style>
