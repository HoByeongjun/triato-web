---
import X from '../assets/theme-images/icon-x.svg'

const { content } = Astro.props
---

<dialog id="demo" closedby="any" class="fixed inset-0 bg-white m-auto z-50 p-6 md:p-12 rounded-xl w-full max-w-[95%] md:max-w-lg shadow-hover border border-bs-border">
  <!-- Form -->
  <form method="dialog" class="flex gap-6 flex-col">
    <!-- Header -->
    <h2 class="text-2xl font-semibold text-bs-text flex justify-between items-center gap-4">
      <span>{content.title}</span>

      <button onclick="this.closest('dialog').close('close')" aria-label="닫기" class="rounded-full p-2 hover:bg-bs-bg-alt transition-colors text-bs-muted">
        <X class="scale-75 opacity-75" width="32" height="32" />
      </button>
    </h2>

    <!-- Content -->
    <div class="flex flex-col gap-4">
      <div class="text-bs-body text-sm mb-3 leading-[1.7] [&_strong]:text-bs-text [&_strong]:font-semibold" set:html={content.content} />

      <label class="sr-only" for="name">이름</label>
      <input id="name" type="text" class="border rounded-lg bg-white border-bs-border form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors text-bs-text placeholder:text-bs-muted" placeholder="이름" />

      <label class="sr-only" for="company">회사명</label>
      <input id="company" type="text" class="border rounded-lg bg-white border-bs-border form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors text-bs-text placeholder:text-bs-muted" placeholder="회사명" />

      <label class="sr-only" for="email">이메일</label>
      <input id="email" type="email" class="border rounded-lg bg-white border-bs-border form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors text-bs-text placeholder:text-bs-muted" placeholder="이메일" />

      <label class="sr-only" for="message">프로젝트 설명</label>
      <textarea id="message" rows="3" class="border rounded-lg bg-white border-bs-border form-input px-4 py-3 focus:border-bs-accent/50 focus:outline-none transition-colors resize-none text-bs-text placeholder:text-bs-muted" placeholder="어떤 프로젝트를 생각하고 계신가요?"></textarea>

      <a href="mailto:bjho@triato.co.kr" class="bs-btn form-input px-4 py-3 bg-bs-navy text-white font-semibold rounded-lg hover:bg-bs-navy-hover text-center">{content.cta}</a>
    </div>
  </form>
</dialog>

<style>
  html:has(dialog[open]) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  dialog[open]::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
  }

  @keyframes scale-up {
    to {
      translate: 0 0;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog {
      translate: 0 2rem;
      scale: 0.8;
    }

    dialog[open] {
      animation: scale-up forwards 0.4s;
      animation-timing-function: var(--ease-bs-spring);
    }
  }
</style>
