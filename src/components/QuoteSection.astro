---
const { content, cite, role } = Astro.props
---

<section class="bg-bs-navy" id="quote">
  <div class="bs-container py-20 lg:py-24">
    <blockquote class="max-w-[720px] mx-auto text-center">
      <!-- Quote mark -->
      <div class="text-bs-accent text-5xl font-serif leading-none mb-6 select-none">"</div>

      <!-- Text -->
      <div set:html={content} class="text-white text-lg md:text-[22px] font-normal leading-[1.7] [&_strong]:text-white [&_strong]:font-normal" />

      <!-- Cite -->
      <cite class="not-italic block mt-8 text-white/60 text-sm">
        — {cite}, {role}
      </cite>
    </blockquote>
  </div>
</section>
