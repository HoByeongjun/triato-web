---
const { content, cite, role } = Astro.props
---

<section class="max-w-[1440px] mx-auto px-6 md:px-20 py-20" id="quote">
  <div class="motion-trigger glass-panel glass-panel-deep rounded-[32px] p-10 md:p-16 lg:p-20 text-center relative overflow-hidden">
    <!-- decorative quote mark -->
    <div class="absolute top-[-40px] left-[40px] text-bs-accent/25 text-[180px] leading-none pointer-events-none font-extrabold select-none" aria-hidden="true">"</div>

    <div
      set:html={content}
      class="text-[28px] md:text-[36px] lg:text-[40px] font-bold leading-[1.25] tracking-[-0.02em] text-bs-text mb-8 relative z-10 [&_strong]:text-bs-accent [&_strong]:font-bold"
    />

    <div class="flex flex-col items-center gap-1 relative z-10">
      <p class="text-[14px] font-semibold text-bs-text">{cite}</p>
      <p class="text-[14px] text-bs-body">{role}</p>
    </div>
  </div>
</section>
