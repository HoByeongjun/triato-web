---
const { settings, title, content } = Astro.props
---

<section class="relative max-w-[1440px] mx-auto px-6 md:px-20 pt-[120px] pb-16 md:pt-[140px] md:pb-24 grid grid-cols-1 lg:grid-cols-[1.25fr_1fr] gap-10 lg:gap-16 items-center min-h-[640px]">
  <div class="hero-blob absolute inset-0 -z-10 pointer-events-none" aria-hidden="true"></div>

  <!-- 좌: 텍스트 (좌측 정렬) -->
  <div class="flex flex-col items-start gap-6 lg:gap-7 max-w-[600px]">
    <!-- E. 카테고리 배지 -->
    <div class="hero-stagger hero-stagger-1 inline-flex items-center px-4 py-2 rounded-full bg-bs-accent-dim border border-bs-border-accent">
      <span class="text-[13px] font-semibold text-bs-accent uppercase tracking-[0.06em]">AI 팀 · 기획부터 운영까지</span>
    </div>

    <!-- A. h1 stagger + B. TRIATO 그라디언트 (home.json span) -->
    <h1 class="hero-stagger hero-stagger-2 text-[40px] md:text-[52px] lg:text-[64px] font-extrabold leading-[1.05] tracking-[-0.03em] text-bs-text" set:html={title} />

    <div class="hero-stagger hero-stagger-3 text-[16px] lg:text-[18px] leading-[1.65] text-bs-body max-w-[44ch] [&>p]:m-0 [&_strong]:text-bs-text [&_strong]:font-semibold" set:html={content} />

    <div class="hero-stagger hero-stagger-4 flex flex-col sm:flex-row gap-3 mt-1">
      <button type="button" class="cta-accent inline-flex items-center justify-center px-7 py-3.5 rounded-full text-[14px] font-bold tracking-[0.02em] shadow-card" onclick="demo.showModal()">
        {settings.demo.cta}
      </button>
      <a class="cta-ghost inline-flex items-center justify-center px-7 py-3.5 rounded-full text-[14px] font-semibold tracking-[0.02em]" href="#services">
        서비스 보기
      </a>
    </div>

    <p class="hero-stagger hero-stagger-5 text-[13px] text-bs-muted">평균 24시간 이내 응답 · 무료 상담</p>
  </div>

  <!-- 우: 영상 (작게, 글래스 패널) -->
  <aside class="hero-stagger hero-stagger-3 relative w-full max-w-[480px] lg:max-w-none lg:justify-self-end">
    <div class="absolute -inset-4 -z-10 rounded-[28px] bg-gradient-to-br from-bs-accent/15 via-white to-bs-navy/10 blur-xl" aria-hidden="true"></div>
    <div class="glass-panel glass-panel-deep rounded-[20px] overflow-hidden bg-white">
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="/images/hero-main2-poster.png"
        class="hero-video2 w-full h-auto block"
        aria-hidden="true"
      >
        <source src="/videos/hero-main2.webm" type="video/webm" />
        <source src="/videos/hero-main2.mp4" type="video/mp4" />
      </video>
      <img
        src="/images/hero-main2-poster.png"
        alt="TRIATO 자동화 데모"
        class="hero-video2-fallback w-full h-auto block"
        loading="lazy"
        decoding="async"
      />
    </div>
  </aside>
</section>

<style>
  .hero-video2-fallback { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-video2 { display: none; }
    .hero-video2-fallback { display: block; }
  }
</style>
