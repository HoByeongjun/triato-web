---
const { settings, title, content } = Astro.props
---

<section class="bg-white relative overflow-hidden">
  <!-- Subtle background texture -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, #0F2D78 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="bs-container pt-20 pb-24 lg:pt-32 lg:pb-36 flex flex-col lg:flex-row items-start lg:items-center gap-12 lg:gap-20 relative">
    <!-- Content -->
    <div class="flex flex-col gap-6 lg:max-w-2xl w-full">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-bs-border bg-white text-[13px] text-bs-body self-start shadow-card">
        <span class="w-1.5 h-1.5 rounded-full bg-bs-accent animate-pulse"></span>
        <span class="font-medium">Trigger</span>
        <svg class="w-3 h-3 text-bs-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
        <span class="font-medium">Action</span>
      </div>

      <!-- Title -->
      <h1 class="bs-h1" set:html={title} />

      <!-- Content -->
      <div class="text-base lg:text-[17px] leading-[1.75] text-bs-body max-w-[480px] flex flex-col gap-3" set:html={content} />

      <!-- CTA -->
      <div class="flex gap-3 mt-6">
        <button type="button" class="bs-btn self-start bg-bs-navy text-white font-semibold px-8 py-3.5 rounded-xl hover:bg-bs-navy-hover hover:-translate-y-0.5 hover:shadow-hover transition-all duration-300" onclick="demo.showModal()">
          {settings.demo.cta}
        </button>
        <a href="/#services" class="bs-btn self-start border-[1.5px] border-black/10 text-bs-text px-8 py-3.5 rounded-xl hover:border-black/20 hover:bg-black/[0.02] transition-all duration-300">
          서비스 보기
        </a>
      </div>
    </div>

    <!-- Visual element -->
    <div class="flex-1 hidden lg:flex place-content-end lg:pl-8">
      <div class="relative w-full max-w-lg">
        <!-- Main photo -->
        <img
          src="/images/hero-visual.jpg"
          alt="TRIATO 개발팀 워크스페이스 — 노트북으로 작업 중인 개발자"
          class="w-full rounded-2xl object-cover shadow-hover border border-black/[0.06]"
          style="aspect-ratio: 3/2;"
        />
        <!-- Accent corner decoration -->
        <div class="absolute -bottom-5 -right-5 w-28 h-28 rounded-2xl bg-bs-accent/6 -z-10"></div>
        <div class="absolute -top-5 -left-5 w-20 h-20 rounded-xl bg-bs-navy/[0.03] -z-10"></div>
        <!-- Small floating badge -->
        <div class="absolute -bottom-4 left-8 bg-white border border-black/[0.06] rounded-xl px-5 py-3 shadow-hover flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-bs-accent"></span>
          <span class="text-[13px] font-semibold text-bs-text tracking-[-0.01em]">AI + 풀스택</span>
        </div>
      </div>
    </div>
  </div>
</section>
