---
import DetailsAccordion from "./DetailsAccordion.astro"

const { title, faq } = Astro.props
---

<section class="max-w-[1440px] mx-auto px-6 md:px-20 py-20 md:py-28" id="faq">

  <!-- Header -->
  <header class="motion-trigger text-center mb-12 lg:mb-14">
    <span class="text-[13px] font-semibold text-bs-accent uppercase tracking-[0.08em]">FAQ</span>
    <h2 class="text-[36px] md:text-[44px] font-bold leading-[1.15] tracking-[-0.025em] text-bs-text mt-3 mb-4" set:html={title} />
    <p class="text-[17px] lg:text-[18px] leading-[1.6] text-bs-body">
      궁금한 점이 있으시면 언제든 연락주세요.
    </p>
  </header>

  <!-- FAQ accordion in glass panel -->
  <div class="glass-panel glass-panel-deep rounded-[24px] p-2 md:p-4 max-w-[820px] mx-auto">
    <div class="px-4 md:px-6">
      {faq.map((item: { question: string; answer: string }) => (
        <DetailsAccordion question={item.question} answer={item.answer} />
      ))}
    </div>
  </div>
</section>
