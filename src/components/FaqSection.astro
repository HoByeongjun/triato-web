---
import DetailsAccordion from "./DetailsAccordion.astro"

const { title, faq } = Astro.props
---

<section class="bg-white" id="faq">
  <div class="bs-container py-20 lg:py-28">
    <div class="max-w-[720px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-12 lg:mb-16">
        { title && <h2 class="bs-h2" set:html={ title } />}
        <p class="text-bs-body mt-4 text-base">궁금한 점이 있으시면 언제든 연락주세요.</p>
      </div>

      <!-- FAQ items -->
      <div class="grid gap-2">
        { faq.map( item =>
          <DetailsAccordion question={item.question} answer={item.answer} />
        )}
      </div>
    </div>
  </div>
</section>
