---
import DetailsAccordion from "./DetailsAccordion.astro"

const { title, faq } = Astro.props
---

<section class="bg-white" id="faq">
  <div class="bs-container py-24 lg:py-32">
    <div class="max-w-[720px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-14 lg:mb-20">
        { title && <h2 class="bs-h2" set:html={ title } />}
        <p class="text-bs-body mt-5 text-base leading-[1.75]">궁금한 점이 있으시면 언제든 연락주세요.</p>
      </div>

      <!-- FAQ items -->
      <div class="grid gap-1">
        { faq.map( (item: { question: string; answer: string }) =>
          <DetailsAccordion question={item.question} answer={item.answer} />
        )}
      </div>
    </div>
  </div>
</section>
