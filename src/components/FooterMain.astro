---
const { settings } = Astro.props
---

<footer class="w-full border-t border-bs-border bg-white" id="footer">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-12 max-w-[1440px] mx-auto px-6 md:px-20 py-16 md:py-20">

    <!-- Brand -->
    <div class="md:col-span-1 flex flex-col gap-3">
      <a class="inline-flex items-center gap-2.5 group self-start" href="#top" aria-label="페이지 상단으로">
        <img src="/logo-symbol.png" alt="TRIATO" class="w-8 h-8 object-contain group-hover:scale-95 transition-transform duration-200" />
        <span class="text-[20px] font-extrabold tracking-[-0.01em] text-bs-text">TRIATO</span>
      </a>
      <p class="text-[15px] text-bs-body mt-3">행동이 시작되는 곳.</p>
      <p class="text-[14px] text-bs-muted">© 2026 TRIATO.</p>
    </div>

    <!-- Contact -->
    <div class="md:col-span-1">
      <h4 class="text-[12px] font-semibold text-bs-text mb-5 uppercase tracking-[0.08em]">연락처</h4>
      <ul class="space-y-3">
        <li><a class="text-[15px] text-bs-body hover:text-bs-text transition-colors duration-200" href="mailto:bjho@triato.co.kr">bjho@triato.co.kr</a></li>
        <li><a class="text-[15px] text-bs-body hover:text-bs-text transition-colors duration-200" href="tel:01072071394">010-7207-1394</a></li>
      </ul>
    </div>

    <!-- Menu -->
    <div class="md:col-span-1">
      <h4 class="text-[12px] font-semibold text-bs-text mb-5 uppercase tracking-[0.08em]">메뉴</h4>
      <ul class="space-y-3">
        {settings.nav.map((item: { link: string; title: string }) => (
          <li><a class="text-[15px] text-bs-body hover:text-bs-text transition-colors duration-200" href={item.link}>{item.title}</a></li>
        ))}
      </ul>
    </div>

    <!-- Company -->
    <div class="md:col-span-1">
      <h4 class="text-[12px] font-semibold text-bs-text mb-5 uppercase tracking-[0.08em]">회사</h4>
      <ul class="space-y-3">
        <li class="text-[15px] text-bs-body">대표 호병준</li>
        <li class="text-[15px] text-bs-body">서울, 대한민국</li>
      </ul>
    </div>
  </div>
</footer>
